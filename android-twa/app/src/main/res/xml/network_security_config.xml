<?xml version="1.0" encoding="utf-8"?>
<!--
    Network Security Configuration для TWA.
    В production используйте только HTTPS (очищенный трафик не разрешён).
    Для debug можно добавить исключения для локальной разработки.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Для debug-сборки можно разрешить localhost (опционально) -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">localhost</domain>
    </domain-config>
</network-security-config>