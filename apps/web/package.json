{
  "name": "@vortex/web",
  "private": true,
  "version": "2.0.16",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "build:native": "tsc -b && vite build --mode native && cap sync android",
    "cap:sync": "cap sync android",
    "cap:open": "cap open android",
    "cap:run": "cap run android",
    "android:debug": "npm run build:native && cd android && gradlew.bat assembleDebug",
    "android:release": "npm run build:native && cd android && gradlew.bat assembleRelease"
  },
  "dependencies": {
    "@capacitor-community/file-opener": "^8.0.1",
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/android": "^8.5.1",
