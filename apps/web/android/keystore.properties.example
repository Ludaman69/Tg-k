# Параметры подписи release-сборки APK.
# Скопируйте в keystore.properties (файл не попадает в git) и заполните.
#
# ВАЖНО: чтобы APK устанавливался поверх ранее выпущенного TWA-приложения
# (com.bkonekte.app), подпись должна быть тем же ключом.
#
# storeFile — путь к keystore относительно папки apps/web/android/app
# (или укажите абсолютный путь, например C:/keys/bkonekte-release.keystore)
storeFile=../../../../android-twa/bkonekte-release.keystore
storePassword=android
keyAlias=bkonekte
keyPassword=android
