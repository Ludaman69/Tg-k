# Server
PORT=3001
JWT_SECRET=your-secure-random-secret-key-here
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/vortex

# Message encryption (AES-256-GCM) — 64-char hex key (32 bytes)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# WARNING: if you lose this key, all encrypted messages become unreadable!
ENCRYPTION_KEY=

# TURN server for voice/video calls (optional, recommended for production)
# Install coturn: sudo apt install coturn
# TURN_URL=turn:your-domain.com:3478
# TURN_SECRET=your-coturn-shared-secret
# STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# Web Push (VAPID) — push-уведомления о сообщениях и звонках
# Сгенерировать ключи: npx web-push generate-vapid-keys --json
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@your-domain.com

# ─── Мобильное приложение (Capacitor / Android) ───────────────────────
#
# Каталог, из которого раздаются APK-файлы (относительно apps/server/).
# Туда же кладётся version.json с метаданными последней версии.
# DOWNLOADS_DIR=downloads
#
# FCM для push-уведомлений в мобильном приложении.
# Скачайте JSON сервисного аккаунта в Firebase Console:
#   Project settings → Service accounts → Generate new private key
# FCM_SERVICE_ACCOUNT=fcm-service-account.json
#
# ВАЖНО: origins нативного WebView (https://localhost, capacitor://localhost)
# добавляются в CORS автоматически — указывать их в CORS_ORIGINS не нужно.
